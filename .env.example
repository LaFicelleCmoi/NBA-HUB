# ---------------------------------------------------------------
# HoopsHub — variables d'environnement (toutes optionnelles).
# Copier en .env.local pour le développement.
# ---------------------------------------------------------------

# --- Côté serveur uniquement (jamais exposées au navigateur) ---
# Bases des API amont (valeurs par défaut ci-dessous)
ESPN_SITE_API=https://site.api.espn.com/apis/site/v2/sports/basketball
ESPN_STANDINGS_API=https://site.api.espn.com/apis/v2/sports/basketball
ESPN_WEB_API=https://site.web.api.espn.com/apis/site/v3/sports/basketball
# L'EuroLeague passe par le paquet « euroleague-api », qui gère ses propres
# adresses : aucune variable n'est nécessaire.
# Timeout des requêtes amont (ms)
UPSTREAM_TIMEOUT_MS=12000

# Flux RSS d'actualités (le « / » final des flux WordPress est conservé)
NEWS_BASKETUSA_RSS=https://www.basketusa.com/feed/
NEWS_EUROLEAGUE_FR_RSS=https://www.basketeurope.com/category/euroleague/feed/
NEWS_EUROLEAGUE_EN_RSS=https://www.eurohoops.net/en/category/euroleague/feed/

# Rate limiting de /api (par IP et par instance)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Publiques (préfixe NEXT_PUBLIC_, incluses dans le bundle client) ---
# URL canonique du site (métadonnées Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Lien externe « tracker » affiché dans le header
NEXT_PUBLIC_TRACKER_URL=https://www.nba.com/stats
NEXT_PUBLIC_TRACKER_LABEL=Stats
